{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "lib": ["ES2023"],
    "outDir": "./dist",
    "declaration": true,
    "removeComments": true,
    "strictPropertyInitialization": false,
    "types": ["node"],
    "rootDir": "./src"
  },
  "include": ["src"]
}
